  "icons": [
    { "src": "icones/icone-192-v2.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icones/icone-512-v2.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icones/icone-maskable-512-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icones/icone-v2.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Cadernos", "url": "./#cadernos", "icons": [{ "src": "icones/icone-192-v2.png", "sizes": "192x192" }] },
    { "name": "Calendário", "url": "./#calendario", "icons": [{ "src": "icones/icone-192-v2.png", "sizes": "192x192" }] },
    { "name": "Questões", "url": "./#questoes", "icons": [{ "src": "icones/icone-192-v2.png", "sizes": "192x192" }] },
    { "name": "Nova leitura", "url": "./#biblioteca/novo", "icons": [{ "src": "icones/icone-192-v2.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
